THOR_APP_CLIENT_ID="[client_id from thor dev portal]"
THOR_APP_CLIENT_SECRET="[client_secret from thor dev portal]"
THOR_APP_URL="[url where your app is running, e.g. http://localhost:3000]"
THOR_APP_SCOPES="[comma separated list of scopes your app needs, e.g. products:view,channels:view]"

# Optional endpoint overrides for development or an enterprise Thor installation.
